---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/book', label: 'Book' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="fixed top-0 z-50 w-full border-b border-surface-highest bg-surface/90 backdrop-blur-xl">
  <div class="mx-auto flex h-20 max-w-5xl items-center justify-between px-5">
    <a href="/" class="flex items-center gap-3">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary font-serif text-lg text-on-primary">M</span>
      <span class="flex flex-col leading-tight">
        <span class="font-serif text-xl text-primary">Maggie Bailey</span>
        <span class="text-[11px] text-on-surface-variant">Distance Energy Healing</span>
      </span>
    </a>
    <nav class="flex items-center gap-1 sm:gap-3">
      {links.map(({ href, label }) => (
        <a href={href}
           aria-current={path === href ? 'page' : undefined}
           class:list={['rounded-full px-3 py-2 text-xs font-semibold uppercase tracking-widest transition hover:text-primary',
                        path === href ? 'text-primary' : 'text-on-surface-variant']}>
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>
