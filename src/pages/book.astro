---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Book a Distance Session — Maggie Bailey">
  <section class="mx-auto max-w-2xl px-5 py-16 text-center">
    <p class="label">Book a session</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">Distance IET sessions</h1>
    <p class="mt-4 text-lg text-on-surface-variant">Sessions are held remotely, so you can receive from anywhere in the world.</p>
    <div class="card mt-10">
      <!-- TODO: replace with the real booking link or form (e.g. Calendly, Acuity) and add pricing. -->
      <p class="text-on-surface-variant">Online booking is being set up. Check back soon.</p>
    </div>
  </section>
</Layout>
